{
  "quietStartup": true,
  "lastChangelogVersion": "0.99.1",
  "defaultProvider": "macos-net-omlx",
  "externalEditor": "vim",
  "packages": [
    "npm:pi-context-view",
    "npm:@aliou/pi-guardrails",
    "npm:pi-turn-metrics",
