{
  "quietStartup": true,
  "lastChangelogVersion": "1.0.1",
  "defaultProvider": "macos-net-omlx",
  "externalEditor": "vim",
  "packages": [
    "npm:pi-context-view",
    "npm:@aliou/pi-guardrails",
    "npm:pi-turn-metrics",
    "npm:@specode/pi-last-model-effort",
    "npm:pi-notify",
    "npm:pi-print-stream",
    "npm:pi-context-shake",
    "git:github.com/k0valik/pi-edit-guard"
  ],
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true
  },
  "theme": "light/dark",
  "defaultTools": [
    "+codemode"
  ]
}