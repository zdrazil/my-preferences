#!/usr/bin/env bash

set -e

API="http://192.168.1.81:8080/v1"
FALLBACK_MODEL="Qwen3.6-35B"

model=$(
    curl -sf "$API/models" |
        jq -r '.data[] | select(.status.value == "loaded") | .id' |
        head -n1
) || true

model="${model:-$FALLBACK_MODEL}"

echo "Using model: $model" >&2

msg=$(
    {
        echo '--- git diff --staged ---'
        git diff --staged

        echo
        echo '--- git log -10 --oneline ---'
        git log -10 --oneline
    } |
        pi --print \
            --model "$model" \
            --provider windows \
            --thinking off \
            'Match the existing commit message style in this repository.

Structure:
- **Subject**: imperative mood, under 72 characters, describing the effect of
  the change rather than the mechanics. "Prevent duplicate signups", not
  "Add unique constraint".
- **Footer**: issue references in the format this repo already uses.

Output only the commit message.
'
)

echo "$msg"

git commit -m "$msg"